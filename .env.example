# ---- Backend (.env) — copy to backend/.env and edit ----
# NEVER commit the real .env file.

APP_NAME="IUB Cafeteria API"
ENV=dev

# SQLite for quick local dev; use Postgres via docker-compose or a real server.
DATABASE_URL=sqlite:///./iub_cafeteria.db
# Example Postgres URL:
# DATABASE_URL=postgresql+psycopg://iub_cafe:iub_cafe_dev_pw@localhost:5432/iub_cafeteria

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-secret-change-me  # min 16 chars; >=32 required in ENV=prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=10080  # 7 days
JWT_ISSUER=iub-pay
JWT_AUDIENCE=iub-pay-client

# Comma-separated origins allowed by CORS ("*" only for development)
# In ENV=prod, "*" is rejected — set explicit origins e.g. https://your.app
CORS_ORIGINS=*

# Shared secret between mock payment provider simulation and the webhook endpoint
MOCK_PAYMENT_WEBHOOK_TOKEN=mock-webhook-token-dev  # min 16 chars; >=32 in prod

SERVICE_FEE_TAKA=5  # fallback; per-vendor override via vendors.service_fee_taka
ALLOW_TEST_REGISTRATION=true  # must be false in prod
# Rate limiting
# RATE_LIMIT_LOGIN=5/minute
# RATE_LIMIT_WEBHOOK=10/minute
