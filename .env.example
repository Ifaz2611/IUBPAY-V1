# ---- Backend (.env) — copy to backend/.env and edit ----
# NEVER commit the real .env file.

APP_NAME="IUB Cafeteria API"
ENV=dev

# SQLite for quick local dev; use Postgres via docker-compose or a real server.
DATABASE_URL=sqlite:///./iub_cafeteria.db
# Example Postgres URL:
# DATABASE_URL=postgresql+psycopg://iub_cafe:iub_cafe_dev_pw@localhost:5432/iub_cafeteria

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Comma-separated origins allowed by CORS ("*" only for development)
CORS_ORIGINS=*

# Shared secret between mock payment provider simulation and the webhook endpoint
MOCK_PAYMENT_WEBHOOK_TOKEN=mock-webhook-token-dev

SERVICE_FEE_TAKA=5
ALLOW_TEST_REGISTRATION=true
